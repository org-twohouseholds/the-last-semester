<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="robots" content="noindex">
    <title>Delete Account – The Last Semester</title>
    <style>
        :root {
            --bg: #14121a;
            --card: #1f1c28;
            --border: #34303f;
            --text: #ece9f2;
            --muted: #a49fb0;
            --accent: #e5484d;
            --accent-hover: #f2555a;
            --ok: #3fb950;
            --focus: #8b7cf6;
        }
        * { box-sizing: border-box; }
        body {
            margin: 0;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 24px;
            background: var(--bg);
            color: var(--text);
            font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
            line-height: 1.5;
        }
        main {
            width: 100%;
            max-width: 440px;
            background: var(--card);
            border: 1px solid var(--border);
            border-radius: 12px;
            padding: 32px;
        }
        h1 { margin: 0 0 4px; font-size: 1.5rem; }
        .subtitle { margin: 0 0 24px; color: var(--muted); font-size: 0.95rem; }
        .warning {
            border-left: 3px solid var(--accent);
            background: rgba(229, 72, 77, 0.08);
            padding: 12px 14px;
            border-radius: 6px;
            font-size: 0.9rem;
            margin-bottom: 24px;
        }
        label { display: block; font-weight: 600; font-size: 0.9rem; margin-bottom: 6px; }
        input[type="text"], input[type="password"] {
            width: 100%;
            padding: 10px 12px;
            margin-bottom: 4px;
            border: 1px solid var(--border);
            border-radius: 8px;
            background: var(--bg);
            color: var(--text);
            font-size: 1rem;
        }
        input:focus-visible, button:focus-visible {
            outline: 2px solid var(--focus);
            outline-offset: 2px;
        }
        .hint { color: var(--muted); font-size: 0.8rem; margin: 0 0 16px; }
        .confirm {
            display: flex;
            gap: 10px;
            align-items: flex-start;
            font-weight: 400;
            font-size: 0.9rem;
            margin: 8px 0 24px;
            cursor: pointer;
        }
        .confirm input { margin-top: 4px; accent-color: var(--accent); }
        button {
            width: 100%;
            padding: 12px;
            border: 0;
            border-radius: 8px;
            background: var(--accent);
            color: #fff;
            font-size: 1rem;
            font-weight: 600;
            cursor: pointer;
        }
        button:hover:not(:disabled) { background: var(--accent-hover); }
        button:disabled { opacity: 0.5; cursor: not-allowed; }
        .message {
            margin-top: 16px;
            padding: 12px 14px;
            border-radius: 6px;
            font-size: 0.9rem;
        }
        .message.error { background: rgba(229, 72, 77, 0.12); color: #ffb3b5; }
        .message.success { background: rgba(63, 185, 80, 0.12); color: #9be9a8; }
        .done { text-align: center; }
        .done .icon { font-size: 2.5rem; color: var(--ok); }
        [hidden] { display: none !important; }
    </style>
</head>
<body>
<main>
    <section id="form-view">
        <h1>Delete your account</h1>
        <p class="subtitle">The Last Semester</p>

        <div class="warning">
            Deleting your account is <strong>permanent</strong>. Your account and all
            associated game data will be removed and cannot be restored.
        </div>

        <form id="delete-form" novalidate>
            <label for="username">Username</label>
            <input id="username" name="username" type="text" autocomplete="username"
                   autocapitalize="off" spellcheck="false" maxlength="20" required>
            <p class="hint">3–20 characters: letters, digits, underscore.</p>

            <label for="password">Password</label>
            <input id="password" name="password" type="password"
                   autocomplete="current-password" maxlength="128" required>
            <p class="hint">The password you use to log in to the game.</p>

            <label class="confirm">
                <input id="confirm" type="checkbox">
                <span>I understand that my account will be permanently deleted.</span>
            </label>

            <button id="submit" type="submit" disabled>Delete account permanently</button>
        </form>

        <div id="message" class="message" role="alert" hidden></div>
    </section>

    <section id="done-view" class="done" hidden>
        <div class="icon" aria-hidden="true">&#10003;</div>
        <h1>Account deleted</h1>
        <p class="subtitle">Your account has been permanently deleted. You can close this page.</p>
    </section>
</main>

<script>
    (function () {
        "use strict";

        // Must match com.extracreditstudios.thelastsemester.shared.messages.Protocol.VERSION
        const PROTOCOL_VERSION = "1.0.0";
        // Served by the backend itself, so a relative URL hits the same origin.
        const ENDPOINT = "/api/account/delete-with-credentials";
        // Same rule as MessageValidator.validateUsername on the server.
        const USERNAME_PATTERN = /^[A-Za-z0-9_]{3,20}$/;

        const form = document.getElementById("delete-form");
        const usernameInput = document.getElementById("username");
        const passwordInput = document.getElementById("password");
        const confirmBox = document.getElementById("confirm");
        const submitBtn = document.getElementById("submit");
        const messageBox = document.getElementById("message");
        const formView = document.getElementById("form-view");
        const doneView = document.getElementById("done-view");

        let busy = false;

        function updateButton() {
            submitBtn.disabled = busy
                || !confirmBox.checked
                || usernameInput.value.trim() === ""
                || passwordInput.value === "";
        }

        function showError(text) {
            messageBox.textContent = text;
            messageBox.className = "message error";
            messageBox.hidden = false;
        }

        function clearMessage() {
            messageBox.hidden = true;
            messageBox.textContent = "";
        }

        function messageForStatus(status) {
            switch (status) {
                case 400: return "Please check your input. A valid username and password are required.";
                case 403: return "Username or password is incorrect.";
                case 409: return "Your account was changed while it was being deleted. Please try again.";
                case 426: return "This page is out of date. Please reload it and try again.";
                case 429: return "Too many attempts. Please wait a moment and try again.";
                default:
                    return status >= 500
                        ? "The server could not process the request. Please try again later."
                        : "Something went wrong (HTTP " + status + "). Please try again.";
            }
        }

        [usernameInput, passwordInput, confirmBox].forEach(function (el) {
            el.addEventListener("input", updateButton);
            el.addEventListener("change", updateButton);
        });

        form.addEventListener("submit", async function (event) {
            event.preventDefault();
            clearMessage();

            const username = usernameInput.value.trim();
            const password = passwordInput.value;

            if (!USERNAME_PATTERN.test(username)) {
                showError("Username must be 3–20 characters: letters, digits, underscore.");
                usernameInput.focus();
                return;
            }
            if (password === "") {
                showError("Please enter your password.");
                passwordInput.focus();
                return;
            }
            if (!confirmBox.checked) {
                showError("Please confirm that you want to delete your account.");
                return;
            }

            busy = true;
            updateButton();
            submitBtn.textContent = "Deleting…";

            try {
                const response = await fetch(ENDPOINT, {
                    method: "POST",
                    headers: {
                        "Content-Type": "application/json",
                        "Accept": "application/json",
                        "protocol-version": PROTOCOL_VERSION
                    },
                    // The server rejects any extra fields: exactly username + password.
                    body: JSON.stringify({ username: username, password: password }),
                    credentials: "omit",
                    cache: "no-store"
                });

                if (response.status === 204 || response.ok) {
                    passwordInput.value = "";
                    formView.hidden = true;
                    doneView.hidden = false;
                    return;
                }

                showError(messageForStatus(response.status));
                if (response.status === 403) {
                    passwordInput.value = "";
                    passwordInput.focus();
                }
            } catch (err) {
                showError("Could not reach the server. Please check your connection and try again.");
            } finally {
                busy = false;
                submitBtn.textContent = "Delete account permanently";
                updateButton();
            }
        });
    })();
</script>
</body>
</html>
